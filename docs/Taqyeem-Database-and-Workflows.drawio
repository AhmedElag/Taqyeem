        <mxCell id="n12" value="&lt;b&gt;Reject link&lt;/b&gt;&lt;br&gt;&lt;br&gt;Expired / revoked / used&lt;br&gt;Admin may reissue; old link stays invalid" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBEDED;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
