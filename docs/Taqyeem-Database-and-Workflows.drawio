        <mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n18" target="n20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;Stop and reconcile&lt;/b&gt;&lt;br&gt;&lt;br&gt;422: incomplete or invalid data&lt;br&gt;409: newer draft/publication or changed context&lt;br&gt;403: no current permission&lt;br&gt;&lt;br&gt;Keep previous publication intact.&lt;br&gt;Reload before trying a stale edit again." style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBEDED;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="530" width="420" height="190" as="geometry" />
        </mxCell>
        <mxCell id="e23" value="Conflict" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n12" target="n22">
