        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;Deliver single-use login link&lt;/b&gt;&lt;br&gt;&lt;br&gt;Configured verified email sender&lt;br&gt;15-minute expiry; verifier hash at rest" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="905" y="555" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n23" value="&lt;b&gt;User opens and explicitly signs in&lt;/b&gt;&lt;br&gt;&lt;br&gt;Token removed from URL fragment&lt;br&gt;Opening an email preview alone does not redeem it" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="905" y="705" width="440" height="105" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="Valid, active and unused?" style="shape=rhombus;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBF1E3;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="985" y="865" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;Reject / request a new link&lt;/b&gt;&lt;br&gt;&lt;br&gt;No session from expired, reused, revoked, or inactive access" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBEDED;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1380" y="860" width="225" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;Consume and create session atomically&lt;/b&gt;&lt;br&gt;&lt;br&gt;No replay window between token redemption&lt;br&gt;and session creation" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF4EE;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
