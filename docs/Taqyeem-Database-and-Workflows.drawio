        <mxCell id="n1" value="TAQYEEM  |  تقييم" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#155F53;strokeColor=#C9DAD2;fontColor=white;fontSize=21;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;fontStyle=1;" vertex="1" parent="1">
