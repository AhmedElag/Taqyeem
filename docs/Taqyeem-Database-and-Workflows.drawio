        <mxCell id="n2" value="06  Files, reports and account lifecycle" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#183C35;fontSize=26;fontFamily=Helvetica;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="27" width="1310" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Three operational workflows with different authorized actors. File review is acknowledgment in the training log, not a clinical outcome certification." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#647B74;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="83" width="1620" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Taqyeem v2 • English default / Arabic RTL • Editable design aligned to the source migration" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#647B74;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="1470" width="1620" height="25" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="A  Resident file-number log" style="swimlane;html=1;rounded=1;startSize=45;horizontal=1;fillColor=#FBF1E3;swimlaneFillColor=#FAFCFB;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=17;fontStyle=1;spacingLeft=15;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="170" width="510" height="1160" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="B  Administrator report" style="swimlane;html=1;rounded=1;startSize=45;horizontal=1;fillColor=#EAF0F9;swimlaneFillColor=#FAFCFB;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=17;fontStyle=1;spacingLeft=15;align=left;" vertex="1" parent="1">
          <mxGeometry x="600" y="170" width="510" height="1160" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="C  Account access changes" style="swimlane;html=1;rounded=1;startSize=45;horizontal=1;fillColor=#F0EDF8;swimlaneFillColor=#FAFCFB;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=17;fontStyle=1;spacingLeft=15;align=left;" vertex="1" parent="1">
          <mxGeometry x="1150" y="170" width="510" height="1160" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;Resident enters reference + work date&lt;/b&gt;&lt;br&gt;&lt;br&gt;No patient name, diagnosis or document upload" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBF1E3;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="85" y="255" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;Server binds the signed-in resident&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ignore/refuse arbitrary actor IDs&lt;br&gt;Normalize case and Arabic/Persian digits&lt;br&gt;Validate reference format and date" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="85" y="420" width="440" height="125" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;Enforce resident-scoped uniqueness&lt;/b&gt;&lt;br&gt;&lt;br&gt;Duplicate → conflict, no new row&lt;br&gt;Same number may belong to another resident’s log" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="85" y="610" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;Commit file_log record&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reference • resident • work date • submission time&lt;br&gt;Confirm only after write succeeds" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF4EE;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="85" y="775" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;Assigned doctor / admin reviews&lt;/b&gt;&lt;br&gt;&lt;br&gt;Server checks current assignment&lt;br&gt;Store reviewed_by and reviewed_at" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="85" y="940" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;Resident sees own submitted references&lt;/b&gt;&lt;br&gt;&lt;br&gt;No other residents’ files&lt;br&gt;No access to assessments through file links" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBF1E3;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="85" y="1115" width="440" height="115" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n8" target="n9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n10" target="n11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n11" target="n12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n12" target="n13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n19" value="&lt;b&gt;Administrator chooses report filters&lt;/b&gt;&lt;br&gt;&lt;br&gt;Program • resident • month • language" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="635" y="255" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="&lt;b&gt;Authorize and query current publications&lt;/b&gt;&lt;br&gt;&lt;br&gt;Use evaluation_heads for the selected month&lt;br&gt;Use historical program/year snapshots&lt;br&gt;Missing assessment ≠ zero" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="635" y="420" width="440" height="125" as="geometry" />
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;Build the filtered summary&lt;/b&gt;&lt;br&gt;&lt;br&gt;Rating + category scores + period file count&lt;br&gt;One contribution per evaluated resident" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="635" y="610" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;Exclude drafts and private notes&lt;/b&gt;&lt;br&gt;&lt;br&gt;Student and doctor roles cannot call this export" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBF1E3;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="635" y="775" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n23" value="&lt;b&gt;Generate CSV / printable report&lt;/b&gt;&lt;br&gt;&lt;br&gt;UTF-8 Arabic support&lt;br&gt;Quote values and prevent formula interpretation" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF4EE;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="635" y="940" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;Review the actual filtered result&lt;/b&gt;&lt;br&gt;&lt;br&gt;Earlier corrected versions do not count twice&lt;br&gt;No invented score for empty selections" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="635" y="1115" width="440" height="115" as="geometry" />
        </mxCell>
        <mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n19" target="n20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n20" target="n21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n21" target="n22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n22" target="n23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n23" target="n24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n30" value="&lt;b&gt;Administrator edits account or assignment&lt;/b&gt;&lt;br&gt;&lt;br&gt;No public role escalation; sole admin protected" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0EDF8;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1185" y="255" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n31" value="&lt;b&gt;Check downstream assignments&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reassign active/pending residents before&lt;br&gt;doctor deactivation or email change,&lt;br&gt;or removal of required program access" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1185" y="420" width="440" height="125" as="geometry" />
        </mxCell>
        <mxCell id="n32" value="&lt;b&gt;Commit lifecycle change + audit&lt;/b&gt;&lt;br&gt;&lt;br&gt;End prior assignment when reassigning&lt;br&gt;Preserve authorship, files and assessments" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1185" y="610" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;Revoke sessions and access links&lt;/b&gt;&lt;br&gt;&lt;br&gt;Deactivation or email change takes effect&lt;br&gt;on the next API authorization check" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBEDED;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1185" y="775" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n34" value="&lt;b&gt;Reactivation requires valid supervision&lt;/b&gt;&lt;br&gt;&lt;br&gt;Active eligible psychiatrist and program&lt;br&gt;Fresh seven-day invitation; pending until accepted&lt;br&gt;Old links remain revoked" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1185" y="940" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n35" value="&lt;b&gt;Changed email → fresh invitation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Return account to pending&lt;br&gt;Verify possession through new single-use link" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF4EE;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1185" y="1115" width="440" height="115" as="geometry" />
        </mxCell>
        <mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n30" target="n31">
