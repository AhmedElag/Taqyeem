        <mxCell id="n11" value="Valid, pending and unused?" style="shape=rhombus;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBF1E3;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
