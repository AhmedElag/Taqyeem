        </mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n14" target="n16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="&lt;b&gt;Revalidate the publication&lt;/b&gt;&lt;br&gt;&lt;br&gt;Current assignment + program/year + template&lt;br&gt;All required 1–10 scores&lt;br&gt;Draft version + resident version + publication ID&lt;br&gt;Server calculates the equal-weight mean" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="570" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="e19" value="Publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n10" target="n18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="All checks pass?" style="shape=rhombus;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBF1E3;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
