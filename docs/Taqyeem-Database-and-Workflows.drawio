        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;Application Worker / API&lt;/b&gt;&lt;br&gt;&lt;br&gt;Authenticate → authorize → validate → calculate → commit&lt;br&gt;Exact Origin + CSRF checks • narrow student responses&lt;br&gt;Only confirmed server writes become “saved”." style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#155F53;strokeColor=#C9DAD2;fontColor=white;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="450" y="625" width="700" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;D1 relational database&lt;/b&gt;&lt;br&gt;&lt;br&gt;Users and assignments&lt;br&gt;Versioned rubrics • immutable publications&lt;br&gt;File references • audit • session/token verifiers" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF4EE;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
