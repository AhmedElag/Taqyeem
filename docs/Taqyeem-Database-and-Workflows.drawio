        <mxCell id="n13" value="&lt;b&gt;Activate and consume in one transaction&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pending → active&lt;br&gt;Create a fresh authenticated session" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF4EE;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
