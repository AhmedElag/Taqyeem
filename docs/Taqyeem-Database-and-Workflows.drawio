        <mxCell id="e35" value="Session" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n26" target="n33">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n36" value="One-time bootstrap creates the pending administrator and activation invitation. The operator may rotate a lost/expired invitation only before first activation; active owners cannot be reset by that route." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#647B74;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="1350" width="1560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n37" value="Logout revokes the current session. Deactivation or an email change revokes all sessions and outstanding access tokens for that account." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#647B74;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="1410" width="1560" height="35" as="geometry" />
