        <mxCell id="n2" value="04  Invitations and sign-in" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#183C35;fontSize=26;fontFamily=Helvetica;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="27" width="1300" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Invite first, then authenticate. Account roles and permitted programs are taken from server records; the visitor cannot choose a privileged role." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#647B74;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="83" width="1610" height="52" as="geometry" />
