        <mxCell id="n8" value="&lt;b&gt;Bilingual live frontend&lt;/b&gt;&lt;br&gt;&lt;br&gt;English by default • Arabic RTL • responsive phone/tablet layout&lt;br&gt;Session role comes from the server. No live role switch." style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF4EE;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=17;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
