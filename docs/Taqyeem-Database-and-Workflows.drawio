        <mxCell id="n33" value="&lt;b&gt;Protected session → role-specific workspace&lt;/b&gt;&lt;br&gt;&lt;br&gt;8-hour absolute / 30-minute idle expiry • HttpOnly + Secure cookie • CSRF + exact Origin on writes" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#155F53;strokeColor=#C9DAD2;fontColor=white;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
