        <mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n28" target="n29">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n34" value="&lt;b&gt;Student API: own latest published number only&lt;/b&gt;&lt;br&gt;&lt;br&gt;{ score, period } + own permitted profile/file log&lt;br&gt;No category details, private notes, peers or staff reports" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBF1E3;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="490" y="1380" width="720" height="110" as="geometry" />
