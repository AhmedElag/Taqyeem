        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n7" target="n10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;Save draft with captured revisions&lt;/b&gt;&lt;br&gt;&lt;br&gt;Server checks author, assignment, context,&lt;br&gt;allowed values, and last loaded draft + resident revisions" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0EDF8;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="380" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="Save draft" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n10" target="n12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;Draft confirmed&lt;/b&gt;&lt;br&gt;&lt;br&gt;Increment draft version and reload saved state&lt;br&gt;No published score changes" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF4EE;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
