        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;Configured email delivery&lt;/b&gt;&lt;br&gt;&lt;br&gt;Requested sign-in links&lt;br&gt;Invitations are copied/shared by admin&lt;br&gt;No permanent default passwords" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F7F5;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
