              <mxPoint x="975" y="1240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n24" value="Cross-cutting FKs are written inside the cards to keep the map readable: assignments also reference users; invitations also reference programs and their creator." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#647B74;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="1310" width="1340" height="45" as="geometry" />
        </mxCell>
        <mxCell id="n25" value="Account deactivation increments/revokes authorization state; historical authorship remains. Bootstrap is an operational marker, not a second identity table." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#647B74;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="1360" width="1340" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
