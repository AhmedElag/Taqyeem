          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="&lt;b&gt;User requests email sign-in&lt;/b&gt;&lt;br&gt;&lt;br&gt;Only pre-registered active accounts can receive a usable link" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF4EE;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="905" y="240" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;Rate limit and generic response&lt;/b&gt;&lt;br&gt;&lt;br&gt;Same public outcome for eligible and unknown addresses&lt;br&gt;Do not disclose account existence" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
