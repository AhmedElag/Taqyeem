        <mxCell id="n5" value="&lt;b&gt;Administrator&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dr. Khaled Abdelazim&lt;br&gt;Accounts • assignments • questions • reports" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
