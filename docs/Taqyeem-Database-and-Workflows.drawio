        <mxCell id="n3" value="A psychiatry residency workspace: a narrow resident view, an assigned-supervisor workflow, and a complete administrator view." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#647B74;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1">
