        <mxCell id="n2" value="05  Assessment, publication and correction" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#183C35;fontSize=26;fontFamily=Helvetica;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="27" width="1300" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="One primary supervisor; one authoritative publication per resident and month. Staff notes and question scores never enter the student response." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#647B74;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="83" width="1610" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Taqyeem v2 • English default / Arabic RTL • Editable design aligned to the source migration" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#647B74;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="1640" width="1610" height="25" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;Open an assigned resident&lt;/b&gt;&lt;br&gt;&lt;br&gt;Administrator may open any resident&lt;br&gt;Doctor must have a current assignment" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="180" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;Load assessment context&lt;/b&gt;&lt;br&gt;&lt;br&gt;Program + training year + month&lt;br&gt;Immutable template version + current publication ID" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="635" y="180" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;Score categories and add educational notes&lt;/b&gt;&lt;br&gt;&lt;br&gt;Every published category: integer 1–10&lt;br&gt;Blank values are allowed only in drafts" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0EDF8;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="180" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n5" target="n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n6" target="n7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="Save draft or publish?" style="shape=rhombus;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBF1E3;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
