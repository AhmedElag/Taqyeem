        <mxCell id="n4" value="Taqyeem v2 • English default / Arabic RTL • Editable design aligned to the source migration" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#647B74;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="1470" width="1610" height="25" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="A  Invitation / first access" style="swimlane;html=1;rounded=1;startSize=45;horizontal=1;fillColor=#EAF0F9;swimlaneFillColor=#FAFCFB;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=17;fontStyle=1;spacingLeft=15;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="165" width="785" height="1150" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="B  Returning-user sign-in" style="swimlane;html=1;rounded=1;startSize=45;horizontal=1;fillColor=#EAF4EE;swimlaneFillColor=#FAFCFB;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=17;fontStyle=1;spacingLeft=15;align=left;" vertex="1" parent="1">
          <mxGeometry x="865" y="165" width="785" height="1150" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;Administrator creates invitation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Doctor program membership or resident + assignment" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="240" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;Server registers pending account&lt;/b&gt;&lt;br&gt;&lt;br&gt;Unique email • random token hash • seven-day expiry&lt;br&gt;Create account + invitation + audit atomically" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="390" width="440" height="115" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;Administrator shares the returned link&lt;/b&gt;&lt;br&gt;&lt;br&gt;Copy once; no reusable token in the invitation list" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="555" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;Invitee opens the page&lt;/b&gt;&lt;br&gt;&lt;br&gt;Strip URL fragment into memory&lt;br&gt;Preview identity / role; explicit Accept button" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="705" width="440" height="105" as="geometry" />
