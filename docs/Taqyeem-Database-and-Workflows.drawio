        <mxCell id="n36" value="Correction workflow: start a new assessment using the prior publication ID, then follow the same validation and atomic publication. Never edit a published snapshot in place." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#647B74;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1">
