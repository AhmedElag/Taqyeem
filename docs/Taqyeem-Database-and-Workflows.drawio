              <mxPoint x="275" y="750" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n25" value="Atomic publication batch — all succeed or none are committed" style="swimlane;html=1;rounded=1;startSize=45;horizontal=1;fillColor=#EAF4EE;swimlaneFillColor=#FAFCFB;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=17;fontStyle=1;spacingLeft=15;align=left;" vertex="1" parent="1">
          <mxGeometry x="65" y="1030" width="1565" height="275" as="geometry" />
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;Snapshot the result&lt;/b&gt;&lt;br&gt;&lt;br&gt;New publication + category scores&lt;br&gt;Original question wording&lt;br&gt;Program/year and author" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="1120" width="335" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n27" value="&lt;b&gt;Preserve earlier publication&lt;/b&gt;&lt;br&gt;&lt;br&gt;Earlier result remains immutable&lt;br&gt;base_published_id identifies it&lt;br&gt;New publication becomes current" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="490" y="1120" width="335" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n28" value="&lt;b&gt;Advance evaluation_heads&lt;/b&gt;&lt;br&gt;&lt;br&gt;Exactly one resident/month pointer&lt;br&gt;Consume the actor’s draft&lt;br&gt;Conditional guard blocks stale writes" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="880" y="1120" width="335" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n29" value="&lt;b&gt;Append audit event&lt;/b&gt;&lt;br&gt;&lt;br&gt;Actor • action • affected record • time&lt;br&gt;No bearer token or note text&lt;br&gt;Return success only after commit" style="shape=rect;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9DAD2;fontColor=#183C35;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1270" y="1120" width="325" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e30" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n20" target="n26">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1420" y="990" />
              <mxPoint x="267" y="990" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#155F53;fontColor=#647B74;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n26" target="n27">
